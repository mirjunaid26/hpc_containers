Bootstrap: docker
From: pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime

%labels
    Description LLM Training Container
    Author HPC User

%post
    # Install git and system deps
    apt-get update && apt-get install -y --no-install-recommends git

    # Install LLM specific libraries
    pip install transformers datasets accelerate bitsandbytes peft scipy

%environment
    # Set default precision to potentially speed up (optional)
    export TORCH_DTYPE=float16

%runscript
    python "$@"

%test
    python -c "import torch; print('Torch version:', torch.__version__)"
    python -c "import transformers; assert transformers.utils.is_torch_available(), 'transformers cannot see PyTorch -- check torch/transformers version compatibility'; print('Transformers version:', transformers.__version__)"
    python -c "import bitsandbytes; print('BitsAndBytes version:', bitsandbytes.__version__)"